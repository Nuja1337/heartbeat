# Response headers for the static Worker (Cloudflare reads this file from dist/).
# Scripts come only from this origin. Inline styles are allowed for the noscript message.
# Everything the app loads is bundled or stored in the browser, so no other origin is needed.
# Rules apply in order. A later rule adds to an earlier one, and "! Name" drops a header the earlier rule set.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-pHoAob60Tx8a7HCwRPCCsdqjDsyGc6sOc4ts0yU1Q7s='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), fullscreen=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cache-Control: no-cache

# Hashed build output never changes, so it can be kept for a year. The host answers a missing /assets file with the
# app's HTML, and that answer gets this header too. A stale tab that asks for a removed chunk reloads itself
# (see src/main.tsx), and a new build has new hashes, so the kept HTML is never asked for again.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  ! Cache-Control
  Cache-Control: public, max-age=86400

/og.png
  ! Cache-Control
  Cache-Control: public, max-age=86400
